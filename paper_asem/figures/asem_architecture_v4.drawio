=top;" vertex="1" parent="1"><mxGeometry x="270" y="115" width="210" height="80" as="geometry" /></mxCell><mxCell id="ops" value='&lt;b&gt;Guarded operators&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;ADD / UPDATE / LINK&lt;br&gt;quote &amp;#8849; turn, value &amp;#8849; quote,&lt;br&gt;dates parsed and ordered; 15 unit tests&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="270" height="95" as="geometry" /></mxCell><mxCell id="derived" value='&lt;b&gt;Derived layer D&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;versioned notes (key, value, sources, valid-from)&lt;br&gt;supersede chains; replayable from A&lt;sub&gt;t&lt;/sub&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="280" height="95" as="geometry" /></mxCell><mxCell id="more" value='&lt;b&gt;SPLIT / MERGE / PRUNE / REORG&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;triggered by label-free read-path signals&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;dashed=1;dashPattern=4 4;opacity=80;" vertex="1" parent="1"><mxGeometry x="1150" y="115" width="230" height="80" as="geometry" /></mxCell><mxCell id="n-write" value="&lt;b&gt;Proved (Prop. 1-3)&lt;/b&gt;&lt;br&gt;every note grounded in A&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;one current version per key&lt;br&gt;layer rebuildable from the log" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="165" height="110" as="geometry" /></mxCell><mxCell id="e-s-a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="stream" target="archive"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-a-o" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="archive" target="ops"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-o-d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="ops" target="derived"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-m-o" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="more" target="ops"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="gpath" value="Layered memory graph G&lt;sub&gt;t&lt;/sub&gt; (built per history, no LLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1560" height="250" as="geometry" /></mxCell><mxCell id="enc" value='&lt;b&gt;Qwen3-Embedding-0.6B&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;GPU, fp16, last-token pooling&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="200" height="65" as="geometry" /></mxCell><mxCell id="l3" value='&lt;b&gt;L3 communities&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;Louvain, seeded&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="260" height="42" as="geometry" /></mxCell><mxCell id="l2" value="&lt;b&gt;L2 sessions&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="290" y="372" width="260" height="34" as="geometry" /></mxCell><mxCell id="l1" value='&lt;b&gt;L1 entities&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;capitalized, 2-5% of turns&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="290" y="416" width="260" height="42" as="geometry" /></mxCell><mxCell id="l0" value='&lt;b&gt;L0 turns&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;next edges, semantic 5-NN&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="290" y="468" width="260" height="42" as="geometry" /></mxCell><mxCell id="ppr" value='&lt;b&gt;Typed PPR influence&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;&amp;#960; = &amp;#945;s&lt;sub&gt;q&lt;/sub&gt; + (1-&amp;#945;)&amp;#960;P, 5 dense seeds&lt;br&gt;rank = 0.7 z(dense) + 0.3 z(&amp;#960;)&lt;br&gt;mass beyond h hops &amp;#8804; (1-&amp;#945;)&lt;sup&gt;h+1&lt;/sup&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="610" y="330" width="330" height="100" as="geometry" /></mxCell><mxCell id="notesL" value='&lt;b&gt;Notes of D&lt;sub&gt;t&lt;/sub&gt; as graph nodes&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;cite edges to their source turns&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;dashed=1;dashPattern=4 4;opacity=80;" vertex="1" parent="1"><mxGeometry x="610" y="450" width="330" height="60" as="geometry" /></mxCell><mxCell id="n-graph" value="&lt;b&gt;Dev recall, LoCoMo (1,531 q)&lt;/b&gt;&lt;br&gt;top-8: dense 0.617, graph 0.618&lt;br&gt;top-18: dense 0.725, graph 0.736&lt;br&gt;community round-robin: 0.415&lt;br&gt;per history: ~588 turns, 93 entities,&lt;br&gt;27 sessions, 10 communities" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="990" y="320" width="300" height="150" as="geometry" /></mxCell><mxCell id="e-a-enc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="archive" target="enc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-enc-l0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="enc" target="l0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-enc-l1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="enc" target="l1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-l2-ppr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="l2" target="ppr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-n-l0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="notesL" target="l0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-d-n" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="derived" target="notesL"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rpath" value="Read path (CARE with dense seeds and graph-aware repair; at most two reader calls)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="1560" height="320" as="geometry" /></mxCell><mxCell id="agg" value='&lt;b&gt;Aggregation over notes&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;count / sum / difference by code&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;dashed=1;dashPattern=4 4;opacity=80;" vertex="1" parent="1"><mxGeometry x="40" y="615" width="200" height="70" as="geometry" /></mxCell><mxCell id="expand" value='&lt;b&gt;Repair expansion&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;lexical: BM25, stemmed, neighbours, searches Q&lt;br&gt;&amp;#8746; dense top-6 (hybrid arm)&lt;br&gt;&amp;#8746; graph-PPR top-6 (graph arm)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="605" width="300" height="95" as="geometry" /></mxCell><mxCell id="reader2" value='&lt;b&gt;Reader R&lt;sub&gt;&amp;#952;&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;once more&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="650" y="620" width="150" height="60" as="geometry" /></mxCell><mxCell id="out" value='&lt;b&gt;Answer or abstention&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;citations projected to archive turns&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="615" width="200" height="70" as="geometry" /></mxCell><mxCell id="q" value="&lt;b&gt;Question q&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="120" height="55" as="geometry" /></mxCell><mxCell id="seed" value='&lt;b&gt;First bundle&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;BM25 or dense top-8, &amp;#8804; 10,000 chars&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="785" width="190" height="65" as="geometry" /></mxCell><mxCell id="reader" value='&lt;b&gt;Reader R&lt;sub&gt;&amp;#952;&lt;/sub&gt; (Qwen3-8B)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;JSON: answer, cited IDs, searches&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="410" y="785" width="210" height="65" as="geometry" /></mxCell><mxCell id="check" value='&lt;b&gt;Code checks&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;citation in bundle; speaker / event binding&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="785" width="200" height="65" as="geometry" /></mxCell><mxCell id="gate" value='&lt;b&gt;Gate &amp;#964;(q)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 9px;"&gt;invalid, or abstained with searches or risk cue&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="785" width="190" height="65" as="geometry" /></mxCell><mxCell id="n-read" value="&lt;b&gt;LoCoMo, 1,986 q, same reader&lt;/b&gt;&lt;br&gt;CARE (BM25 + lexical repair): 0.5256&lt;br&gt;dense first pass: 0.4730 (+0.014 vs BM25, 9/10 conv.)&lt;br&gt;dense + lexical repair: 0.5169 (-0.009, CI includes 0)&lt;br&gt;repair: +0.067 but -46 correct refusals&lt;br&gt;6 verifiers: best &amp;#945;/&amp;#946; = 2.31 &amp;lt; 3.89 needed; all lose&lt;br&gt;&lt;i&gt;factorial with hybrid / graph arms: running&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1110" y="600" width="450" height="160" as="geometry" /></mxCell><mxCell id="e-q-s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="q" target="seed"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-s-r" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="seed" target="reader"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-r-c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="reader" target="check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-c-g" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="check" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-g-o" value="&amp;#964; = 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="out"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-g-x" value="&amp;#964; = 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="expand"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-x-r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="expand" target="reader2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-r2-o" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1" source="reader2" target="out"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-agg-x" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="agg" target="expand"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-ppr-x" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=block;endFill=1;dashed=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ppr" target="expand"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="infra" value="&lt;b&gt;Infrastructure&lt;/b&gt;: Kaggle 2&amp;#215;T4 &amp;#183; vLLM (fp16, 8,192-token window, greedy, max-num-seqs 1) &amp;#183; Qwen3-8B and Qwen3-Embedding-0.6B at pinned revisions &amp;#183; open weights only &amp;#183; reruns reproduce saved answers 98/98" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="1560" height="36" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
