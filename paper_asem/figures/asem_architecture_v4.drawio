<mxfile host="Electron" version="28.0.6"><diagram name="ASEM architecture v4" id="asem-arch-v4"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="970" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ASEM / CARE architecture (draft v4, 17 Nov 2026): what is built and what is evaluated" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1100" height="26" as="geometry" /></mxCell><mxCell id="key-0" value="&lt;span&gt;Evaluated end to end&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=top;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="180" height="22" as="geometry" /></mxCell><mxCell id="key-1" value="&lt;span&gt;Implemented, evaluation running&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="210" y="40" width="180" height="22" as="geometry" /></mxCell><mxCell id="key-2" value="&lt;span&gt;Specified only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;dashed=1;dashPattern=4 4;opacity=80;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="180" height="22" as="geometry" /></mxCell><mxCell id="key-3" value="&lt;span&gt;Code check / gate&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="590" y="40" width="180" height="22" as="geometry" /></mxCell><mxCell id="key-4" value="&lt;span&gt;Model / infra&lt;/span&gt;" sty